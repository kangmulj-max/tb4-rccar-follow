<?xml version="1.0"?>
<!--
  follow_arena: 실습장(회색 바닥 + 나무 펜스)을 단순화한 월드
  - rc_car : 데이터셋의 검은색 RC카(G바겐형)를 본뜬 타깃. /model/rc_car/cmd_vel(gz) 로 구동
  - dummy_box : 데이터셋 'dummy' 클래스(검은 박스형 장치)를 본뜬 방해물(정지)
-->
<sdf version="1.9">
  <!-- follow_arena_slam1004: make_slam_world.py 로 생성 (arena_1004_run1.yaml) -->
  <world name="follow_arena">
    <scene>
      <grid>false</grid>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.85 0.87 0.9 1</background>
    </scene>
    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- 바닥: 회색 카펫 -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material><ambient>0.36 0.36 0.37 1</ambient><diffuse>0.40 0.40 0.41 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <!-- 실물 SLAM 지도 arena_1004_run1.pgm 의 막힌 칸 → 벽 (높이 0.5 m). 좌표 = 지도 좌표 -->

    <!-- 타깃: 검은색 RC카 (길이 0.26 m, 폭 0.12 m, 높이 0.14 m) -->
        <!-- rc_car: 실측 치수 적용 (apply_real_specs.py) -->
    <model name="rc_car">
      <pose>60 60 0 0 0 0</pose>
      <link name="body">
        <inertial>
          <pose>0.0000 0.0000 0.0367 0 0 0</pose>
          <mass>1.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <!-- 충돌체는 단일 박스, 마찰 0 → VelocityControl로 미끄러지듯 이동 -->
        <collision name="c">
          <pose>0.0000 0.0000 0.0428 0 0 0</pose>
          <geometry><box><size>0.2317 0.0653 0.0734</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>

        <!-- 하부 차체 -->
        <visual name="lower">
          <pose>0.0000 0.0000 0.0355 0 0 0</pose>
          <geometry><box><size>0.2228 0.0642 0.0306</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <!-- 캐빈 (박스형) -->
        <visual name="cabin">
          <pose>-0.0178 0.0000 0.0660 0 0 0</pose>
          <geometry><box><size>0.1604 0.0610 0.0318</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <!-- 지붕 -->
        <visual name="roof">
          <pose>-0.0178 0.0000 0.0832 0 0 0</pose>
          <geometry><box><size>0.1515 0.0577 0.0037</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <!-- 유리창 (짙은 회색 광택) -->
        <visual name="win_side">
          <pose>-0.0178 0.0000 0.0685 0 0 0</pose>
          <geometry><box><size>0.1337 0.0620 0.0159</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <visual name="win_front">
          <pose>0.0633 0.0000 0.0685 0 0 0</pose>
          <geometry><box><size>0.0036 0.0522 0.0183</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <visual name="win_rear">
          <pose>-0.0989 0.0000 0.0685 0 0 0</pose>
          <geometry><box><size>0.0036 0.0522 0.0183</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <!-- 보닛 -->
        <visual name="hood">
          <pose>0.0891 0.0000 0.0520 0 0 0</pose>
          <geometry><box><size>0.0535 0.0610 0.0037</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <!-- 펜더 -->
        <visual name="fender_fl"><pose>0.0758 0.0337 0.0428 0 0 0</pose><geometry><box><size>0.0535 0.0065 0.0135</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_fr"><pose>0.0758 -0.0337 0.0428 0 0 0</pose><geometry><box><size>0.0535 0.0065 0.0135</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_rl"><pose>-0.0758 0.0337 0.0428 0 0 0</pose><geometry><box><size>0.0535 0.0065 0.0135</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_rr"><pose>-0.0758 -0.0337 0.0428 0 0 0</pose><geometry><box><size>0.0535 0.0065 0.0135</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <!-- 바퀴 4개 -->
        <visual name="wheel_fl"><pose>0.0758 0.0316 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.0141</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_fr"><pose>0.0758 -0.0316 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.0141</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_rl"><pose>-0.0758 0.0316 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.0141</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_rr"><pose>-0.0758 -0.0316 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0202</radius><length>0.0141</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <!-- 휠 허브 (짙은 은색) -->
        <visual name="hub_fl"><pose>0.0758 0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_fr"><pose>0.0758 -0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rl"><pose>-0.0758 0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rr"><pose>-0.0758 -0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <!-- 뒤 스페어타이어 + 은색 커버 링 -->
        <visual name="spare"><pose>-0.1221 0.0000 0.0520 0 1.5708 0</pose><geometry><cylinder><radius>0.0163</radius><length>0.0196</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="spare_cover"><pose>-0.1328 0.0000 0.0520 0 1.5708 0</pose><geometry><cylinder><radius>0.0120</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <!-- 앞 그릴(은색) + 헤드램프 -->
        <visual name="grille"><pose>0.1132 0.0000 0.0385 0 0 0</pose><geometry><box><size>0.0027 0.0327 0.0135</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="lamp_l"><pose>0.1132 0.0239 0.0404 0 1.5708 0</pose><geometry><cylinder><radius>0.0049</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <visual name="lamp_r"><pose>0.1132 -0.0239 0.0404 0 1.5708 0</pose><geometry><cylinder><radius>0.0049</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <!-- 후미등 -->
        <visual name="tail_l"><pose>-0.1132 0.0272 0.0397 0 0 0</pose><geometry><box><size>0.0027 0.0065 0.0110</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
        <visual name="tail_r"><pose>-0.1132 -0.0272 0.0397 0 0 0</pose><geometry><box><size>0.0027 0.0065 0.0110</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/rc_car/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </model>

    <!-- 방해물: 데이터셋 'dummy' 클래스를 본뜬 검은 박스형 장치 (높이 0.1 m → 라이다 평면 아래) -->
    <model name="dummy_box">
      <pose>63 60 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>3.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.15 0.12 0.1</size></box></geometry></collision>
        <visual name="plate"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>0.19 0.14 0.006</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="body"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.14 0.12 0.09</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
        <visual name="label"><pose>0 0 0.0955 0 0 0</pose><geometry><box><size>0.1 0.08 0.001</size></box></geometry>
          <material><ambient>0.8 0.8 0.5 1</ambient><diffuse>0.9 0.9 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 녹화용 천장 탑뷰 카메라 (7 m 위, 아래를 봄). gz 토픽 /overhead/image -->
    <model name="overhead_cam">
      <static>true</static>
      <pose>75 60 0 0 0 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>720</height></image>
            <clip><near>0.5</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>overhead/image</topic>
        </sensor>
      </link>
    </model>

    <!-- 실습장 웹캠 재현 (웹캠 YOLO my_best.pt 시험용). gz 토픽 /webcam/image -> ROS /sim/webcam
         자세는 데이터셋(rokey_mp4_a1 v2) valid/test 라벨 박스 101 개로 역추정:
         높이 1.29 m, 아래로 48.1 deg, 640x640 정사각(center crop) 에서 f ~750 px -> HFOV 0.805 rad.
         부트스트랩 범위 h 1.32+-0.09, pitch 45.6+-2.0, f 671+-60. 카메라 x,y 는 실측값이 없어 임의 배치. -->
    <model name="webcam_cam">
      <static>true</static>
      <pose>72 60 0 0 0 0</pose>
      <link name="link">
        <sensor name="webcam" type="camera">
          <camera>
            <horizontal_fov>0.805</horizontal_fov>
            <image><width>640</width><height>640</height></image>
            <clip><near>0.1</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>webcam/image</topic>
        </sensor>
      </link>
    </model>

    <!-- 안전 시험용 가는 폴 (5 cm, 높이 0.6 m): 정면 정중앙 장애물 — RC카를 가리지 않음 -->
    <model name="pole">
      <pose>69 60 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.2</ixx><iyy>1.2</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.9 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 안전 시험용 기둥 (높이 0.6 m → 라이다에 보임). 평소엔 펜스 밖에 대기, set_pose 로 경로에 투입 -->
    <model name="pillar">
      <pose>66 60 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.4</ixx><iyy>1.4</iyy><izz>0.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.85 0.85 0.87 1</diffuse></material></visual>
      </link>
    </model>
    <!-- 가공 공장 -->
    <model name="structure"><static>true</static><pose>0 0 0 0 0 0</pose><link name="l"><collision name="c0"><pose>0.000 6.100 1.250 0 0 0.0000</pose><geometry><box><size>18.400 0.200 2.500</size></box></geometry></collision><visual name="v0"><pose>0.000 6.100 1.250 0 0 0.0000</pose><geometry><box><size>18.400 0.200 2.500</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual><collision name="c1"><pose>0.000 -6.100 1.250 0 0 0.0000</pose><geometry><box><size>18.400 0.200 2.500</size></box></geometry></collision><visual name="v1"><pose>0.000 -6.100 1.250 0 0 0.0000</pose><geometry><box><size>18.400 0.200 2.500</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual><collision name="c2"><pose>9.100 0.000 1.250 0 0 0.0000</pose><geometry><box><size>0.200 12.000 2.500</size></box></geometry></collision><visual name="v2"><pose>9.100 0.000 1.250 0 0 0.0000</pose><geometry><box><size>0.200 12.000 2.500</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual><collision name="c3"><pose>-9.100 0.000 1.250 0 0 0.0000</pose><geometry><box><size>0.200 12.000 2.500</size></box></geometry></collision><visual name="v3"><pose>-9.100 0.000 1.250 0 0 0.0000</pose><geometry><box><size>0.200 12.000 2.500</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual><collision name="c4"><pose>6.800 -5.000 1.250 0 0 0.0000</pose><geometry><box><size>0.150 2.000 2.500</size></box></geometry></collision><visual name="v4"><pose>6.800 -5.000 1.250 0 0 0.0000</pose><geometry><box><size>0.150 2.000 2.500</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual><collision name="c5"><pose>8.000 -4.050 1.250 0 0 0.0000</pose><geometry><box><size>2.200 0.150 2.500</size></box