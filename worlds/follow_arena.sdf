<?xml version="1.0"?>
<!--
  follow_arena: 실습장(회색 바닥 + 나무 펜스)을 단순화한 월드
  - rc_car : 데이터셋의 검은색 RC카(G바겐형)를 본뜬 타깃. /model/rc_car/cmd_vel(gz) 로 구동
  - dummy_box : 데이터셋 'dummy' 클래스(검은 박스형 장치)를 본뜬 방해물(정지)
-->
<sdf version="1.9">
  <world name="follow_arena">
    <scene>
      <grid>false</grid>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.85 0.87 0.9 1</background>
    </scene>
    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- 바닥: 회색 카펫 -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.36 0.36 0.37 1</ambient><diffuse>0.40 0.40 0.41 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- 나무 펜스 8 x 6 m, 높이 0.5 m -->
    <model name="fence">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>4.0 0 0.25 0 0 0</pose><geometry><box><size>0.03 6 0.5</size></box></geometry></collision>
        <visual name="n"><pose>4.0 0 0.25 0 0 0</pose><geometry><box><size>0.03 6 0.5</size></box></geometry>
          <material><ambient>0.66 0.52 0.36 1</ambient><diffuse>0.78 0.62 0.43 1</diffuse></material></visual>
        <collision name="s"><pose>-4.0 0 0.25 0 0 0</pose><geometry><box><size>0.03 6 0.5</size></box></geometry></collision>
        <visual name="s"><pose>-4.0 0 0.25 0 0 0</pose><geometry><box><size>0.03 6 0.5</size></box></geometry>
          <material><ambient>0.66 0.52 0.36 1</ambient><diffuse>0.78 0.62 0.43 1</diffuse></material></visual>
        <collision name="e"><pose>0 -3.0 0.25 0 0 0</pose><geometry><box><size>8 0.03 0.5</size></box></geometry></collision>
        <visual name="e"><pose>0 -3.0 0.25 0 0 0</pose><geometry><box><size>8 0.03 0.5</size></box></geometry>
          <material><ambient>0.66 0.52 0.36 1</ambient><diffuse>0.78 0.62 0.43 1</diffuse></material></visual>
        <collision name="w"><pose>0 3.0 0.25 0 0 0</pose><geometry><box><size>8 0.03 0.5</size></box></geometry></collision>
        <visual name="w"><pose>0 3.0 0.25 0 0 0</pose><geometry><box><size>8 0.03 0.5</size></box></geometry>
          <material><ambient>0.66 0.52 0.36 1</ambient><diffuse>0.78 0.62 0.43 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 타깃: 검은색 RC카 (길이 0.26 m, 폭 0.12 m, 높이 0.14 m) -->
    <model name="rc_car">
      <pose>1.2 0 0 0 0 0</pose>
      <link name="body">
        <inertial>
          <pose>0 0 0.06 0 0 0</pose>
          <mass>1.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <!-- 충돌체는 단일 박스, 마찰 0 → VelocityControl로 미끄러지듯 이동 -->
        <collision name="c">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry><box><size>0.26 0.12 0.12</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>

        <!-- 하부 차체 -->
        <visual name="lower">
          <pose>0 0 0.058 0 0 0</pose>
          <geometry><box><size>0.25 0.118 0.05</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <!-- 캐빈 (박스형) -->
        <visual name="cabin">
          <pose>-0.02 0 0.108 0 0 0</pose>
          <geometry><box><size>0.18 0.112 0.052</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <!-- 지붕 -->
        <visual name="roof">
          <pose>-0.02 0 0.136 0 0 0</pose>
          <geometry><box><size>0.17 0.106 0.006</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <!-- 유리창 (짙은 회색 광택) -->
        <visual name="win_side">
          <pose>-0.02 0 0.112 0 0 0</pose>
          <geometry><box><size>0.15 0.114 0.026</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <visual name="win_front">
          <pose>0.071 0 0.112 0 0 0</pose>
          <geometry><box><size>0.004 0.096 0.03</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <visual name="win_rear">
          <pose>-0.111 0 0.112 0 0 0</pose>
          <geometry><box><size>0.004 0.096 0.03</size></box></geometry>
          <material><ambient>0.08 0.09 0.1 1</ambient><diffuse>0.12 0.13 0.15 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
        <!-- 보닛 -->
        <visual name="hood">
          <pose>0.1 0 0.085 0 0 0</pose>
          <geometry><box><size>0.06 0.112 0.006</size></box></geometry>
          <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <!-- 펜더 -->
        <visual name="fender_fl"><pose>0.085 0.062 0.07 0 0 0</pose><geometry><box><size>0.06 0.012 0.022</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_fr"><pose>0.085 -0.062 0.07 0 0 0</pose><geometry><box><size>0.06 0.012 0.022</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_rl"><pose>-0.085 0.062 0.07 0 0 0</pose><geometry><box><size>0.06 0.012 0.022</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="fender_rr"><pose>-0.085 -0.062 0.07 0 0 0</pose><geometry><box><size>0.06 0.012 0.022</size></box></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <!-- 바퀴 4개 -->
        <visual name="wheel_fl"><pose>0.085 0.058 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_fr"><pose>0.085 -0.058 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_rl"><pose>-0.085 0.058 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <visual name="wheel_rr"><pose>-0.085 -0.058 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.026</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <!-- 휠 허브 (짙은 은색) -->
        <visual name="hub_fl"><pose>0.085 0.072 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.017</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_fr"><pose>0.085 -0.072 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.017</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rl"><pose>-0.085 0.072 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.017</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rr"><pose>-0.085 -0.072 0.033 1.5708 0 0</pose><geometry><cylinder><radius>0.017</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <!-- 뒤 스페어타이어 + 은색 커버 링 -->
        <visual name="spare"><pose>-0.137 0 0.085 0 1.5708 0</pose><geometry><cylinder><radius>0.03</radius><length>0.022</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="spare_cover"><pose>-0.149 0 0.085 0 1.5708 0</pose><geometry><cylinder><radius>0.022</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <!-- 앞 그릴(은색) + 헤드램프 -->
        <visual name="grille"><pose>0.127 0 0.063 0 0 0</pose><geometry><box><size>0.003 0.06 0.022</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="lamp_l"><pose>0.127 0.044 0.066 0 1.5708 0</pose><geometry><cylinder><radius>0.009</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <visual name="lamp_r"><pose>0.127 -0.044 0.066 0 1.5708 0</pose><geometry><cylinder><radius>0.009</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <!-- 후미등 -->
        <visual name="tail_l"><pose>-0.127 0.05 0.065 0 0 0</pose><geometry><box><size>0.003 0.012 0.018</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
        <visual name="tail_r"><pose>-0.127 -0.05 0.065 0 0 0</pose><geometry><box><size>0.003 0.012 0.018</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/rc_car/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </model>

    <!-- 방해물: 데이터셋 'dummy' 클래스를 본뜬 검은 박스형 장치 (높이 0.1 m → 라이다 평면 아래) -->
    <model name="dummy_box">
      <pose>2.0 1.2 0 0 0 0.3</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>3.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.15 0.12 0.1</size></box></geometry></collision>
        <visual name="plate"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>0.19 0.14 0.006</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="body"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.14 0.12 0.09</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
        <visual name="label"><pose>0 0 0.0955 0 0 0</pose><geometry><box><size>0.1 0.08 0.001</size></box></geometry>
          <material><ambient>0.8 0.8 0.5 1</ambient><diffuse>0.9 0.9 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 녹화용 천장 탑뷰 카메라 (7 m 위, 아래를 봄). gz 토픽 /overhead/image -->
    <model name="overhead_cam">
      <static>true</static>
      <pose>0 0 7.0 0 1.5708 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>720</height></image>
            <clip><near>0.5</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>overhead/image</topic>
        </sensor>
      </link>
    </model>

    <!-- 안전 시험용 가는 폴 (5 cm, 높이 0.6 m): 정면 정중앙 장애물 — RC카를 가리지 않음 -->
    <model name="pole">
      <pose>6.0 -5.0 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.2</ixx><iyy>1.2</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.9 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 안전 시험용 기둥 (높이 0.6 m → 라이다에 보임). 평소엔 펜스 밖에 대기, set_pose 로 경로에 투입 -->
    <model name="pillar">
      <pose>6.0 5.0 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.4</ixx><iyy>1.4</iyy><izz>0.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.85 0.85 0.87 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
