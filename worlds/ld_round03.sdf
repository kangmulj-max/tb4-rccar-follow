        <!-- 휠 허브 (짙은 은색) -->
        <visual name="hub_fl"><pose>0.0758 0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_fr"><pose>0.0758 -0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rl"><pose>-0.0758 0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="hub_rr"><pose>-0.0758 -0.0392 0.0202 1.5708 0 0</pose><geometry><cylinder><radius>0.0104</radius><length>0.0016</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <!-- 뒤 스페어타이어 + 은색 커버 링 -->
        <visual name="spare"><pose>-0.1221 0.0000 0.0520 0 1.5708 0</pose><geometry><cylinder><radius>0.0163</radius><length>0.0196</length></cylinder></geometry>
          <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
        <visual name="spare_cover"><pose>-0.1328 0.0000 0.0520 0 1.5708 0</pose><geometry><cylinder><radius>0.0120</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.45 0.45 0.47 1</ambient><diffuse>0.55 0.55 0.57 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <!-- 앞 그릴(은색) + 헤드램프 -->
        <visual name="grille"><pose>0.1132 0.0000 0.0385 0 0 0</pose><geometry><box><size>0.0027 0.0327 0.0135</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="lamp_l"><pose>0.1132 0.0239 0.0404 0 1.5708 0</pose><geometry><cylinder><radius>0.0049</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <visual name="lamp_r"><pose>0.1132 -0.0239 0.0404 0 1.5708 0</pose><geometry><cylinder><radius>0.0049</radius><length>0.0027</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <!-- 후미등 -->
        <visual name="tail_l"><pose>-0.1132 0.0272 0.0397 0 0 0</pose><geometry><box><size>0.0027 0.0065 0.0110</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
        <visual name="tail_r"><pose>-0.1132 -0.0272 0.0397 0 0 0</pose><geometry><box><size>0.0027 0.0065 0.0110</size></box></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.6 0.05 0.05 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/rc_car/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </model>

    <!-- 방해물: 데이터셋 'dummy' 클래스를 본뜬 검은 박스형 장치 (높이 0.1 m → 라이다 평면 아래) -->
    <model name="dummy_box">
      <pose>2.0 1.2 0 0 0 0.3</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><mass>3.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.15 0.12 0.1</size></box></geometry></collision>
        <visual name="plate"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>0.19 0.14 0.006</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="body"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>0.14 0.12 0.09</size></box></geometry>
          <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
        <visual name="label"><pose>0 0 0.0955 0 0 0</pose><geometry><box><size>0.1 0.08 0.001</size></box></geometry>
          <material><ambient>0.8 0.8 0.5 1</ambient><diffuse>0.9 0.9 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 녹화용 천장 탑뷰 카메라 (7 m 위, 아래를 봄). gz 토픽 /overhead/image -->
    <model name="overhead_cam">
      <static>true</static>
      <pose>-2.29 -1.88 9.0 0 1.5708 0</pose>
      <link name="link">
        <sensor name="overhead" type="camera">
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>720</height></image>
            <clip><near>0.5</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>overhead/image</topic>
        </sensor>
      </link>
    </model>

    <!-- 실습장 웹캠 재현 (웹캠 YOLO my_best.pt 시험용). gz 토픽 /webcam/image -> ROS /sim/webcam
         자세는 데이터셋(rokey_mp4_a1 v2) valid/test 라벨 박스 101 개로 역추정:
         높이 1.29 m, 아래로 48.1 deg, 640x640 정사각(center crop) 에서 f ~750 px -> HFOV 0.805 rad.
         부트스트랩 범위 h 1.32+-0.09, pitch 45.6+-2.0, f 671+-60. 카메라 x,y 는 실측값이 없어 임의 배치. -->
    <model name="webcam_cam">
      <static>true</static>
      <pose>-0.5 0 1.29 0 0.8395 0</pose>
      <link name="link">
        <sensor name="webcam" type="camera">
          <camera>
            <horizontal_fov>0.805</horizontal_fov>
            <image><width>640</width><height>640</height></image>
            <clip><near>0.1</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>webcam/image</topic>
        </sensor>
      </link>
    </model>

    <!-- 안전 시험용 가는 폴 (5 cm, 높이 0.6 m): 정면 정중앙 장애물 — RC카를 가리지 않음 -->
    <model name="pole">
      <pose>6.0 -5.0 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.2</ixx><iyy>1.2</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.05 0.05 0.6</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.9 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 안전 시험용 기둥 (높이 0.6 m → 라이다에 보임). 평소엔 펜스 밖에 대기, set_pose 로 경로에 투입 -->
    <model name="pillar">
      <pose>6.0 5.0 0 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial><pose>0 0 0.3 0 0 0</pose><mass>40.0</mass><inertia><ixx>1.4</ixx><iyy>1.4</iyy><izz>0.4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.25 0.25 0.6</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.85 0.85 0.87 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Layout Delta 회차 03 배치: {'C': 's2', 'B': 's3', 'E': 's5', 'L': 'l1'} -->
    <model name="obj_C"><static>true</static><pose>-2.35 -1.6 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry></collision><visual name="v"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry><material><ambient>0.3 0.35 0.6 1</ambient><diffuse>0.3 0.35 0.6 1</diffuse></material></visual></link></model>
    <model name="obj_B"><static>true</static><pose>-0.9 -1.5 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry></collision><visual name="v"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry><material><ambient>0.3 0.35 0.6 1</ambient><diffuse>0.3 0.35 0.6 1</diffuse></material></visual></link></model>
    <model name="obj_E"><static>true</static><pose>-3.3 0.45 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry></collision><visual name="v"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.45 0.45 0.5</size></box></geometry><material><ambient>0.3 0.35 0.6 1</ambient><diffuse>0.3 0.35 0.6 1</diffuse></material></visual></link></model>
    <model name="obj_L"><static>true</static><pose>-1.45 -0.6 0 0 0 0</pose><link name="l"><collision name="c"><pose>0 0 0.06 0 0 0</pose><geometry><box><size>0.45 0.45 0.12</size></box></geometry></collision><visual name="v"><pose>0 0 0.06 0 0 0</pose><geometry><box><size>0.45 0.45 0.12</size></box></geometry><material><ambient>0.3 0.35 0.6 1</ambient><diffuse>0.3 0.35 0.6 1</diffuse></material></visual></link></model>
  </world>
</sdf>
